# Kanpla MCP configuration. Copy to .env and fill in. Keep it private (chmod 600).
# See README "Getting your values" for how to obtain these.

KANPLA_FIREBASE_API_KEY=AIza...
KANPLA_EMAIL=you@example.com
KANPLA_PASSWORD=your-password

# Optional: default canteen/module id (or discover it with the list_modules tool).
KANPLA_MODULE_ID=

# Optional overrides.
KANPLA_BASE=https://app.kanpla.io
KANPLA_LANGUAGE=en
